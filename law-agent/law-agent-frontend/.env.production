# -----------------------------
# Frontend Production Environment
# -----------------------------

# Environment
REACT_APP_ENVIRONMENT=production

# API Endpoints (pointing to deployed backend)
REACT_APP_API_URL=https://api.lawagent.com
REACT_APP_ANALYTICS_URL=https://analytics.lawagent.com
REACT_APP_DOCUMENTS_URL=https://documents.lawagent.com

# Supabase Production Configuration
REACT_APP_SUPABASE_URL=https://prod-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=prod-anon-key

# Feature Flags
REACT_APP_ENABLE_3D_VISUALIZATION=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_DOCUMENT_UPLOAD=true

# Legal System
REACT_APP_DEFAULT_JURISDICTION=india
REACT_APP_SUPPORTED_LANGUAGES=en,hi

# Performance & PWA
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_ENABLE_PWA=true

# Security
REACT_APP_ENABLE_CSP=true
REACT_APP_SECURE_COOKIES=true

# Build Config
GENERATE_SOURCEMAP=false
CI=true
BUILD_PATH=build
